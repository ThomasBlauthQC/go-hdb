# Create organizational unit for users
dn: ou=users,dc=example,dc=com
objectClass: organizationalUnit
ou: users

# Create organizational unit for groups
dn: ou=groups,dc=example,dc=com
objectClass: organizationalUnit
ou: groups

# Test user 1 - LDAP user for HANA authentication
# NOTE: extensibleObject allows custom attributes like distinguishedName
# NOTE: distinguishedName is required for HANA LDAP authentication with OpenLDAP
dn: cn=ldapuser1,ou=users,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: extensibleObject
cn: ldapuser1
sn: User1
uid: ldapuser1
uidNumber: 10001
gidNumber: 10000
homeDirectory: /home/ldapuser1
mail: ldapuser1@example.com
userPassword: LdapPass123
distinguishedName: cn=ldapuser1,ou=users,dc=example,dc=com

# Test user 2 - another LDAP user for HANA authentication
dn: cn=ldapuser2,ou=users,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: extensibleObject
cn: ldapuser2
sn: User2
uid: ldapuser2
uidNumber: 10002
gidNumber: 10000
homeDirectory: /home/ldapuser2
mail: ldapuser2@example.com
userPassword: LdapPass456
distinguishedName: cn=ldapuser2,ou=users,dc=example,dc=com

# Service account for HANA to query LDAP (optional, for user lookup)
dn: cn=hanasvc,ou=users,dc=example,dc=com
objectClass: inetOrgPerson
objectClass: posixAccount
objectClass: extensibleObject
cn: hanasvc
sn: Service
uid: hanasvc
uidNumber: 10099
gidNumber: 10000
homeDirectory: /home/hanasvc
userPassword: HanaSvcPass123
distinguishedName: cn=hanasvc,ou=users,dc=example,dc=com

# Group for HANA users - required for LDAP authorization
# NOTE: Using groupOfUniqueNames because the default memberOf overlay
# in osixia/openldap is configured for uniqueMember, not member
dn: cn=hanausers,ou=groups,dc=example,dc=com
objectClass: groupOfUniqueNames
cn: hanausers
uniqueMember: cn=ldapuser1,ou=users,dc=example,dc=com
uniqueMember: cn=ldapuser2,ou=users,dc=example,dc=com
